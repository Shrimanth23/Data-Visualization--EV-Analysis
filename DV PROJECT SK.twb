      <column caption='No of Charging stations' datatype='integer' name='[Calculation_2151594762350714880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([ID])' />
      </column>
      <column caption='No of Electric Vehicles' datatype='integer' name='[Calculation_2151594762361671681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([VIN (Cleaned_Electric_Vehicle_Registration.csv)])' />
      </column>
      <column caption='Charging Stations to Vehicles Ratio' datatype='real' name='[Calculation_2151594762364571650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_2151594762350714880], 0) / IFNULL([Calculation_2151594762361671681], 1)' />
      </column>
      <column caption='COUNTY' datatype='string' name='[Calculation_2151594762385014787]' role='dimension' semantic-role='[County].[Name]' type='nominal'>
        <calculation class='tableau' formula='UPPER(TRIM([COUNTY]))' />
      </column>
      <column caption='COUNTY-CC' datatype='string' name='[Calculation_2151594762389340164]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
        <calculation class='tableau' formula='UPPER(TRIM([County]))' />
      </column>
      <column caption='Percapita Average' datatype='real' name='[Calculation_2151594762399715335]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Income 2020]+[Income 2021]+[Income 2022])/3' />
      </column>
      <column caption='Tax exemption status' datatype='string' name='[Calculation_2151594762405310472]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([MAKE (Cleaned_WA_Tax_Exemptions.csv)]) THEN &quot;Not Exempt&quot;&#13;&#10;ELSE &quot;Exempt&quot;&#13;&#10;END' />
      </column>
      <column caption='PRICE DIFFERENCE' datatype='integer' name='[Calculation_2151594762467057674]' role='measure' type='quantitative'>
